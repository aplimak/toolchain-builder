BR2_BINUTILS_VERSION_2_47_X=y
BR2_GCC_VERSION_16_X=y
BR2_GDB_VERSION_17=y
BR2_DL_DIR="$(BR2_EXTERNAL_AELIUX_EXTERNAL_PATH)/dl"
BR2_PACKAGE_OVERRIDE_FILE="$(BR2_EXTERNAL_AELIUX_EXTERNAL_PATH)/local.mk"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_AELIUX_EXTERNAL_PATH)/patches"
BR2_ROOTFS_MERGED_USR=y
BR2_SYSTEM_DEFAULT_PATH="/bin:/sbin:/usr/bin:/usr/sbin"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_AELIUX_EXTERNAL_PATH)/boards/common/overlay-bash"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_NCURSES_WCHAR=y
BR2_PACKAGE_NCURSES_TARGET_PROGS=y
BR2_PACKAGE_HOST_ENVIRONMENT_SETUP=y
BR2_SYSTEM_BIN_SH_BASH=y
BR2_PACKAGE_BASH_COMPLETION=y
