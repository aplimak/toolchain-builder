config BR2_PACKAGE_ENTER
	bool "enter"
	default y
	depends on BR2_USE_MMU
	help
	  Static isolated-rootfs launcher with best-effort namespace isolation.

	  Installs /enter in the target rootfs. Copy that binary into
	  another rootfs at <rootfs>/enter and run it: the launcher
	  takes its own parent directory as the rootfs and enters it
	  with whatever isolation the running kernel permits.

	  Optional PID, UTS, and IPC namespaces are enabled when supported.
	  A mount namespace is required. Running as a non-root user requires
	  unprivileged user namespaces to be enabled by the host kernel.
	  Missing OverlayFS, sysfs, and devpts support use documented
	  fallbacks or warnings where possible.

	  The rootfs directory must contain /usr and /tmp. A usable /dev and
	  mounted /proc on the host are required; setup failures are reported as errors.

if BR2_PACKAGE_ENTER

config BR2_PACKAGE_ENTER_RUNTIME_WARNINGS
	bool "Show recoverable runtime warnings"
	default y
	help
	  Show non-fatal runtime warnings for optional features and
	  fallback paths. Errors are always reported. Compiler warning
	  diagnostics remain enabled regardless of this setting.

config BR2_PACKAGE_ENTER_OVERLAY
	bool "Enable OverlayFS writable root"
	default y
	help
	  Provide a writable overlay when the rootfs is read-only.

config BR2_PACKAGE_ENTER_IMAGE_OVERLAY
	bool "ext4 image-backed overlay fallback"
	default y
	depends on BR2_PACKAGE_ENTER_OVERLAY
	help
	  When overlay-on-tmpfs cannot be used (e.g. no xattrs),
	  create an ext4 loop image to back upper/work.

config BR2_PACKAGE_ENTER_MKE2FS_PATH
	string "mke2fs path"
	default "mke2fs"
	depends on BR2_PACKAGE_ENTER_IMAGE_OVERLAY
	help
	  Path to the mke2fs or compatible alternatives. Needed for ext4 image creation.

config BR2_PACKAGE_ENTER_PTY_RELAY
	bool "Private PTY relay"
	default y
	help
	  Give the child its own PTY and relay I/O with SIGWINCH handling.

config BR2_PACKAGE_ENTER_USER_NAMESPACE
	bool "Support user namespace"
	default y
	help
	  Attempt USER namespace if uid != 0

config BR2_PACKAGE_ENTER_PID_NAMESPACE
	bool "Support pid namespace"
	default y

config BR2_PACKAGE_ENTER_UTS_NAMESPACE
	bool "Support uts namespace"
	default y

config BR2_PACKAGE_ENTER_IPC_NAMESPACE
	bool "Support ipc namespace"
	default y

config BR2_PACKAGE_ENTER_OPEN_TREE
	bool "Use open_tree/move_mount to enter root"
	default y
	help
	    This method works on newer kernels and will silently fail on older kernels

config BR2_PACKAGE_ENTER_PIVOT_ROOT
	bool "Use pivot_root to enter root"
	default y
	help
	    pivot_root is quirky, its very likely to not work.

config BR2_PACKAGE_ENTER_MOVE_MOUNT
	bool "Use MS_MOVE + chroot to enter root"
	default y
	help
	    This method works on almost all kernels.

config BR2_PACKAGE_ENTER_CHROOT
	bool "Plain chroot as last resort"
	default n
	help
	    This method has major security flaws, its not recommended at all. use it only if other ones not work.

config BR2_PACKAGE_ENTER_ENSURE_USABLE
    bool
    depends on !BR2_PACKAGE_ENTER_OPEN_TREE && !BR2_PACKAGE_ENTER_PIVOT_ROOT
    default y
    select BR2_PACKAGE_ENTER_MOVE_MOUNT

config BR2_PACKAGE_ENTER_DEFAULT_RESOLVER
	bool "Write default /run/resolv.conf"
	default y

endif
